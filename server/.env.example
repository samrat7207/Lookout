# Copy to .env and fill in. .env is gitignored. The key is read only in src/tinyfish/client.js.
TINYFISH_API_KEY=
# Defaults to 8787 when empty.
PORT=
MONITOR_ID=
PUBLIC_WEBHOOK_BASE=
# Opportunities district (hackathons). Set to "off" to cut it. Empty means on.
OPPORTUNITIES=
# live | replay | mock. Empty means live when the key is set, else replay.
MODE=
# Postgres connection string. Empty means the local SQLite fallback (server/.data/lookout.db).
DATABASE_URL=
# Path of the local fallback database. Empty means server/.data/lookout.db.
LOOKOUT_DB_FILE=
