# tests keep their run history away from the real store
LOOKOUT_HISTORY_FILE=.data/history.test.json
# tests use an in-memory local database, never Postgres or the real file
LOOKOUT_DB_FILE=:memory:
DATABASE_URL=
# no request log lines in test output
LOG_REQUESTS=off
# rate limits high enough that the other tests never hit them (limits.test.js sets its own)
RATE_LIMIT_RUN=1000
RATE_LIMIT_RECHECK=1000
RATE_LIMIT_READ=100000
SSE_MAX_PER_IP=1000
# no briefing pause in tests
LOOKOUT_BRIEF_MS=0
